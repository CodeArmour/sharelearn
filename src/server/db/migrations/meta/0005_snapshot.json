      "checkConstraints": {
        "knowledge_items_vocabulary_fields": {
          "name": "knowledge_items_vocabulary_fields",
          "value": "\"knowledge_items\".\"type\" <> 'vocabulary' OR (\"knowledge_items\".\"term\" IS NOT NULL AND \"knowledge_items\".\"meaning\" IS NOT NULL AND \"knowledge_items\".\"part_of_speech\" IS NOT NULL)"
        },
        "knowledge_items_grammar_fields": {
          "name": "knowledge_items_grammar_fields",
          "value": "\"knowledge_items\".\"type\" <> 'grammar' OR (\"knowledge_items\".\"title\" IS NOT NULL AND \"knowledge_items\".\"summary\" IS NOT NULL AND \"knowledge_items\".\"explanation\" IS NOT NULL)"
        },
        "knowledge_items_reading_fields": {
          "name": "knowledge_items_reading_fields",
          "value": "\"knowledge_items\".\"type\" <> 'reading' OR (\"knowledge_items\".\"title\" IS NOT NULL AND \"knowledge_items\".\"body\" IS NOT NULL)"
        },
        "knowledge_items_note_fields": {
          "name": "knowledge_items_note_fields",
          "value": "\"knowledge_items\".\"type\" <> 'note' OR \"knowledge_items\".\"body\" IS NOT NULL"
        },
        "knowledge_items_level_values": {
          "name": "knowledge_items_level_values",
          "value": "\"knowledge_items\".\"level\" IS NULL OR \"knowledge_items\".\"level\" IN ('A1', 'A2', 'B1', 'B2', 'C1', 'C2')"
        }
      },
