# =============================================================================
# Dutch Shared Learning Platform — environment template
#
# Copy to `.env.local` (git-ignored) and fill in as integrations are added.
# The frontend-foundation phase needs NONE of these to run.
# Never commit real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL of the deployment (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (later — Postgres via Supabase or Neon) -----------------------
# DATABASE_URL="postgresql://user:password@host:5432/dutch?sslmode=require"

# --- Auth (later — Auth.js or Supabase Auth) --------------------------------
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# --- Storage (later — Supabase Storage or S3-compatible) --------------------
# STORAGE_BUCKET_URL=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""

# --- AI (Backend Phase 4) ---
# OpenAI API key (https://platform.openai.com/api-keys). OPTIONAL — when absent,
# the Add screen's "Structure with AI" box is hidden and only the manual form
# shows. CI runs without it.
AI_API_KEY=
# Optional primary model override; defaults to gpt-5.6-luna.
AI_MODEL=
# Model to retry with when the primary AI_MODEL call fails. Defaults to
# gpt-5.6-terra. Set equal to AI_MODEL to disable the fallback retry.
OPENAI_FALLBACK_MODEL=

# --- Cron (Backend Phase 5) ---
# Shared secret Vercel Cron sends as `Authorization: Bearer …`. Required in
# production; the staging-bucket sweep route (/api/cron/sweep-capture-staging)
# returns 503 without it. Any long random string.
CRON_SECRET=

# --- Supabase (Backend Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler, port 6543, with ?pgbouncer=true
SUPABASE_DB_POOL_URL=
# Direct connection, port 5432 — drizzle-kit migrations + seed only
SUPABASE_DB_DIRECT_URL=
SITE_URL=http://localhost:3000
# Supabase Auth email delivery (SMTP) is configured in the Supabase dashboard,
# NOT here. The built-in sender is capped at ~2/hour — see
# docs/supabase-auth-email.md for custom SMTP (Resend) + raised rate limits, or
# run `npm run auth:link -- you@example.com` to mint a login link with no email.
# Optional: disposable DB for integration tests (tests skip when unset)
TEST_DATABASE_URL=
